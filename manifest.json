{
  "manifest_version": 3,
  "name": "YouTube Standard 16:9 Player",
  "description": "Keeps every YouTube watch page at the same standard 16:9 player size, including portrait videos.",
  "version": "1.3.0",
  "permissions": [
    "storage"
  ],
  "action": {
    "default_title": "YouTube Standard 16:9 Player",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.youtube.com/*"
      ],
      "css": [
        "content.css"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_start"
    }
  ]
}
